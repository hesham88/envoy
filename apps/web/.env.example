# Copy to apps/web/.env.local (gitignored) and fill in.
# Values: `firebase apps:sdkconfig WEB <appId> --project envoy-hybrid-ai`
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# reCAPTCHA Enterprise website key (Google Cloud console → reCAPTCHA Enterprise)
VITE_RECAPTCHA_SITE_KEY=
# Optional: a stable App Check debug token for localhost (register it in Firebase console → App Check)
VITE_APPCHECK_DEBUG_TOKEN=
# Optional: override the cloud model locally (default comes from Remote Config: gemini-4-hydrogen)
VITE_CLOUD_MODEL=
