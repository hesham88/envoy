{
  "manifest_version": 3,
  "name": "Envoy: private AI agent to the cloud",
  "short_name": "Envoy",
  "version": "0.1.0",
  "description": "Ask cloud AI about private text. Envoy masks your details on your device, and you approve exactly what is sent.",
  "minimum_chrome_version": "138",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "scripting",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Envoy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://www.google.com; frame-src https://envoy-hybrid-ai.web.app"
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
