{
  "name": "@envoy/extension",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode extensiondev --outDir dist-dev",
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:dev": "vite build --mode extensiondev --outDir dist-dev && vite build --mode extensiondev --outDir dist-dev --config vite.content.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:dist": "node ./scripts/verify-dist.mjs",
    "pack": "npm run build && npm run check:dist && node ./scripts/pack.mjs",
    "pack:store": "npm run build && npm run check:dist && node ./scripts/pack.mjs --store",
    "test:e2e": "npm run build && node ./e2e/run.mjs"
  },
  "dependencies": {
    "@envoy/ai": "0.1.0",
    "@envoy/core": "0.1.0",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@envoy/app": "0.1.0",
    "@envoy/ui": "0.1.0",
    "lucide-react": "^1.77.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.6",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5"
  }
}
